{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Comprehensive Audit Domain Contracts",
  "description": "Pydantic-generated schemas for the composite patient input and aggregate report",
  "models": {
    "ComprehensivePatientInput": {
      "$ref": "#/$defs/ComprehensivePatientInput"
    },
    "ComprehensiveAuditReport": {
      "$ref": "#/$defs/ComprehensiveAuditReport"
    }
  },
  "$defs": {
    "AKIIndicesInput": {
      "additionalProperties": false,
      "properties": {
        "urine_sodium_meq_l": {
          "maximum": 300.0,
          "minimum": 0.0,
          "title": "Urine Sodium Meq L",
          "type": "number"
        },
        "serum_sodium_meq_l": {
          "maximum": 180.0,
          "minimum": 100.0,
          "title": "Serum Sodium Meq L",
          "type": "number"
        },
        "urine_creatinine_mg_dl": {
          "exclusiveMinimum": 0.0,
          "maximum": 500.0,
          "title": "Urine Creatinine Mg Dl",
          "type": "number"
        },
        "serum_creatinine_mg_dl": {
          "maximum": 30.0,
          "minimum": 0.1,
          "title": "Serum Creatinine Mg Dl",
          "type": "number"
        },
        "on_diuretics": {
          "default": false,
          "title": "On Diuretics",
          "type": "boolean"
        },
        "serum_bun_mg_dl": {
          "anyOf": [
            {
              "maximum": 200.0,
              "minimum": 1.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Serum Bun Mg Dl"
        },
        "urine_urea_mg_dl": {
          "anyOf": [
            {
              "maximum": 5000.0,
              "minimum": 1.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Urine Urea Mg Dl"
        }
      },
      "required": [
        "urine_sodium_meq_l",
        "serum_sodium_meq_l",
        "urine_creatinine_mg_dl",
        "serum_creatinine_mg_dl"
      ],
      "title": "AKIIndicesInput",
      "type": "object"
    },
    "AKIIndicesOutput": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "$ref": "#/$defs/UCUMUnit",
          "default": "%"
        },
        "clinical_pearls_and_actions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Clinical Pearls And Actions",
          "type": "array"
        },
        "llm_trap_prevented": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Llm Trap Prevented",
          "type": "array"
        },
        "fena_percent": {
          "title": "Fena Percent",
          "type": "number"
        },
        "feurea_percent": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Feurea Percent"
        },
        "aki_etiology": {
          "enum": [
            "prerenal",
            "atn",
            "indeterminate",
            "diuretic_confounded"
          ],
          "title": "Aki Etiology",
          "type": "string"
        }
      },
      "required": [
        "fena_percent",
        "feurea_percent",
        "aki_etiology"
      ],
      "title": "AKIIndicesOutput",
      "type": "object"
    },
    "AcidBaseDisorder": {
      "enum": [
        "NORMAL",
        "PURE_HAGMA",
        "PURE_NAGMA",
        "MIXED_HAGMA_NAGMA",
        "HAGMA_PLUS_METABOLIC_ALKALOSIS_OR_CHRONIC_RESP_ACIDOSIS",
        "UNCOMPENSATED_RESPIRATORY_ACIDOSIS",
        "SUPERIMPOSED_RESPIRATORY_ALKALOSIS"
      ],
      "title": "AcidBaseDisorder",
      "type": "string"
    },
    "AcidBaseInput": {
      "additionalProperties": false,
      "properties": {
        "na_meq_l": {
          "maximum": 180.0,
          "minimum": 100.0,
          "title": "Na Meq L",
          "type": "number"
        },
        "cl_meq_l": {
          "maximum": 150.0,
          "minimum": 50.0,
          "title": "Cl Meq L",
          "type": "number"
        },
        "hco3_meq_l": {
          "maximum": 60.0,
          "minimum": 1.0,
          "title": "Hco3 Meq L",
          "type": "number"
        },
        "albumin_g_dl": {
          "default": 4.0,
          "maximum": 6.0,
          "minimum": 0.5,
          "title": "Albumin G Dl",
          "type": "number"
        },
        "glucose_mg_dl": {
          "default": 100.0,
          "maximum": 2000.0,
          "minimum": 0.0,
          "title": "Glucose Mg Dl",
          "type": "number"
        },
        "paco2_mmhg": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 10.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paco2 Mmhg"
        },
        "ph": {
          "anyOf": [
            {
              "maximum": 7.8,
              "minimum": 6.5,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ph"
        },
        "lactate_mmol_l": {
          "anyOf": [
            {
              "maximum": 30.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lactate Mmol L"
        },
        "prior_known_disorder": {
          "anyOf": [
            {
              "$ref": "#/$defs/AcidBaseDisorder"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "na_meq_l",
        "cl_meq_l",
        "hco3_meq_l"
      ],
      "title": "AcidBaseInput",
      "type": "object"
    },
    "AcidBaseOutput": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "$ref": "#/$defs/UCUMUnit",
          "default": "mEq/L"
        },
        "clinical_pearls_and_actions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Clinical Pearls And Actions",
          "type": "array"
        },
        "llm_trap_prevented": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Llm Trap Prevented",
          "type": "array"
        },
        "raw_anion_gap": {
          "title": "Raw Anion Gap",
          "type": "number"
        },
        "albumin_corrected_anion_gap": {
          "title": "Albumin Corrected Anion Gap",
          "type": "number"
        },
        "delta_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Delta Ratio"
        },
        "winters_expected_paco2_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Winters Expected Paco2 Min"
        },
        "winters_expected_paco2_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Winters Expected Paco2 Max"
        },
        "disorders": {
          "items": {
            "$ref": "#/$defs/AcidBaseDisorder"
          },
          "title": "Disorders",
          "type": "array"
        },
        "corrected_na_katz": {
          "title": "Corrected Na Katz",
          "type": "number"
        },
        "corrected_na_hillier": {
          "title": "Corrected Na Hillier",
          "type": "number"
        },
        "active_na_correction_method": {
          "enum": [
            "katz",
            "hillier"
          ],
